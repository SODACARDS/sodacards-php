{
  "description": "The official PHP SDK for the SODACARDS Developer API.",
  "keywords": [
    "sodacards",
    "gift-cards",
    "game-topup",
    "payments",
    "api",
    "sdk"
  ],
  "homepage": "https://developers.sodacards.com",
  "license": "MIT",
  "authors": [
    {
      "name": "SODACARDS",
      "homepage": "https://developers.sodacards.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^1.7 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.0 || ^9.0",
    "friendsofphp/php-cs-fixer": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "Sodacards\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sodacards\\Test\\": "test/"
    }
  },
  "support": {
    "docs": "https://developers.sodacards.com",
    "email": "support@sodacards.com"
  }
}
